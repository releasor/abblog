MODULE: admin
FILES: src/app/admin/layout.tsx, src/app/admin/login/page.tsx, src/app/admin/(admin)/dashboard/page.tsx
RESPONSIBILITY: admin panel UI — login page, sidebar navigation layout, dashboard placeholder
KEY_FILES:
- src/app/admin/login/page.tsx: client component, email/password form, signIn("credentials") with redirect:false, error display, ~91 lines
- src/app/admin/(admin)/layout.tsx: client component, sidebar (w-64) with nav links, header with admin name + logout, ~76 lines
- src/app/admin/(admin)/dashboard/page.tsx: placeholder dashboard page, ~12 lines
DEPENDENCIES:
- uses: next-auth/react: useSession, signIn, signOut hooks
- imports: next/navigation: useRouter, usePathname
INTERFACES:
- AdminLoginPage: default export, standalone page (no admin layout wrapping)
- AdminLayout: default export, wraps (admin) route group pages with sidebar + header
- AdminDashboard: default export, placeholder dashboard content

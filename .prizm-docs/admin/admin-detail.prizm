MODULE: admin
FILES: src/app/admin/layout.tsx, src/app/admin/login/page.tsx, src/app/admin/(admin)/layout.tsx, src/app/admin/(admin)/dashboard/page.tsx, src/app/admin/(admin)/posts/page.tsx, src/app/admin/(admin)/posts/new/page.tsx, src/app/admin/(admin)/posts/[id]/edit/page.tsx, src/app/admin/(admin)/categories/page.tsx, src/app/admin/(admin)/tags/page.tsx
RESPONSIBILITY: admin panel UI — login page, sidebar navigation layout, dashboard, post/category/tag management pages
KEY_FILES:
- src/app/admin/login/page.tsx: client component, email/password form, signIn("credentials") with redirect:false, error display
- src/app/admin/(admin)/layout.tsx: client component, sidebar (w-64) with nav links (Dashboard, Posts, Categories, Tags, Comments, Settings), header with admin name + logout
- src/app/admin/(admin)/dashboard/page.tsx: placeholder dashboard page
- src/app/admin/(admin)/posts/page.tsx: post list with table, status filter, sort, pagination
- src/app/admin/(admin)/categories/page.tsx: category list with inline create/edit/delete, post counts
- src/app/admin/(admin)/tags/page.tsx: tag list with inline create/edit/delete, post counts
DEPENDENCIES:
- uses: next-auth/react: useSession, signIn, signOut hooks
- imports: next/navigation: useRouter, usePathname
INTERFACES:
- AdminLoginPage: default export, standalone page (no admin layout wrapping)
- AdminLayout: default export, wraps (admin) route group pages with sidebar + header
- AdminDashboard: default export, placeholder dashboard content
- AdminCategoriesPage: default export, client component with category CRUD
- AdminTagsPage: default export, client component with tag CRUD

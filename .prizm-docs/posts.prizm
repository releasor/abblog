MODULE: posts
FILES: src/app/api/posts/route.ts, src/app/api/posts/[id]/route.ts, src/app/api/categories/route.ts, src/app/api/tags/route.ts, src/app/admin/(admin)/posts/page.tsx, src/app/admin/(admin)/posts/new/page.tsx, src/app/admin/(admin)/posts/[id]/edit/page.tsx, src/app/posts/page.tsx, src/app/posts/[slug]/page.tsx, src/app/posts/[slug]/post-content.tsx, src/app/tags/[slug]/page.tsx, src/components/post-form.tsx, src/components/post-card.tsx, src/components/pagination.tsx, src/components/tiptap-editor.tsx, src/lib/slugify.ts, src/lib/reading-time.ts
RESPONSIBILITY: blog post CRUD — API routes, admin pages, public post viewer with syntax highlighting, tag pages, reading time

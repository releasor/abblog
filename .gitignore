# ===========================
# PrizmKit Runtime Artifacts
# ===========================

# PrizmKit 运行时状态（不提交）
.prizmkit/state/

# 多 Agent 协作临时工作区
.dev-team/

# Prizm 文档（按需决定是否提交）
# .prizm-docs/

# 规划产物（按需决定是否提交）
# .prizmkit/plans/

# Dev-Pipeline 运行时状态（已迁移到 .prizmkit/state/）
.prizmkit/state/features/
.prizmkit/state/bugfix/
.prizmkit/state/refactor/
dev-pipeline/logs/
dev-pipeline/*.pid

# Playwright CLI 快照和截图
.playwright-cli/

# ===========================
# Common
# ===========================

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Prisma generated client
/generated/prisma

# ===========================
# Next.js
# ===========================
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Testing
/coverage

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# Pipeline runtime state (auto-added by dev-pipeline)
.prizmkit\state\features/

{
  "permissions": {
    "allow": [
      "Bash(powershell *)",
      "Bash(powershell.exe *)",
      "Bash(curl *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./.prizmkit/scripts/validate-prizm-docs.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./.prizmkit/scripts/diff-prizm-docs.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/native-pipeline.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/native-runner.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/native-daemon.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-feature.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-bugfix.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-refactor.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-recovery.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/launch-feature-daemon.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/launch-bugfix-daemon.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/launch-refactor-daemon.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/reset-feature.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/reset-bug.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/reset-refactor.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/launch-bugfix-daemon.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/launch-feature-daemon.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/launch-refactor-daemon.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/reset-bug.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/reset-feature.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/reset-refactor.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-bugfix.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-feature.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-recovery.ps1 *)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./dev-pipeline/run-refactor.ps1 *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "(?i)\\b(commit|push|finish|ship|merge|pull request|pr)\\b|提交|推送|收尾|完成任务|合并|发版|发布",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ]
  }
}